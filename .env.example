# Copy to .env and fill in. .env is gitignored — never commit a real key.
OPENROUTER_API_KEY=

# Optional: identifies your app to OpenRouter for usage tracking
OPENROUTER_APP_NAME=sciagent

# Optional Neo4j knowledge graph. `docker compose up` uses the same defaults.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
