{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "eval/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
